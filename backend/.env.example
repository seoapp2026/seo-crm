# =============================================================================
# SEO CRM — backend/.env example (local dev)
# Copy to backend/.env and fill in. On Railway the same names go in
# Project → Shared Variables.
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# SQLite by default. For Railway Postgres reference the private DATABASE_URL.
DATABASE_URL=sqlite:///./seo_crm.db

# OpenAI — server-side only, never expose to the browser
OPENAI_API_KEY=sk-your-key-here

# Random secret for sessions/tokens (generate: openssl rand -hex 32)
SECRET_KEY=change-me-in-production

# App login gate — leave empty to disable auth (local dev only)
APP_AUTH_PASSWORD=
# Optional comma-separated allowlist (empty = any email + correct password)
AUTH_ALLOWED_EMAILS=

# ── CREDENTIAL ENCRYPTION AT REST ────────────────────────────────────────────
# Fernet key used to encrypt stored credentials (Google OAuth tokens,
# WordPress application passwords) in the database.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = encryption disabled (credentials stored as plaintext — dev only).
# WARNING: if you lose this key, encrypted credentials become unreadable.
# Keep it in .env / Railway variables AND in your password manager.
APP_ENCRYPTION_KEY=

# ── SERVER / DEPLOY ──────────────────────────────────────────────────────────

# development | production  (production hides /docs)
APP_ENV=development

# Canonical public URL (custom domain), used for CORS and OAuth redirects
APP_PUBLIC_URL=

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Hide Swagger in production
ENABLE_API_DOCS=false

# Set by Railway automatically — do not set manually
# PORT=8000
# STATIC_DIR=/app/frontend/dist

# ── GOOGLE OAUTH ─────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/seo-crm/integrations/google/callback

# ── GOOGLE SERVICE TARGETS (optional global fallbacks; normally per project) ─

GSC_SITE_URL=
GA4_PROPERTY_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional MCC / Manager account ID (digits only)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── BACKGROUND SYNC CRON ─────────────────────────────────────────────────────

SYNC_GSC_CRON=0 6 * * *
SYNC_GA4_CRON=0 7 * * *
SYNC_ADS_CRON=0 8 * * 1

# ── OPTION 2: DataForSEO research (Análisis SEO) ─────────────────────────────
# API login + password from https://app.dataforseo.com/api-access
# (API password ≠ account password). Without these, analyses run in stub mode.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Force fixture data even with credentials (demo/testing). Auto-true when no credentials.
DATAFORSEO_FORCE_STUB=false
# Monthly spend guards (EUR): soft warning and hard stop for new runs (0 = disabled)
DATAFORSEO_SOFT_MONTHLY_EUR=50
DATAFORSEO_HARD_MONTHLY_EUR=100
# Optional per-run caps (defaults shown)
# DATAFORSEO_MAX_COMPETITORS=3
# DATAFORSEO_MAX_SEED_KEYWORDS=20
# DATAFORSEO_MAX_KEYWORDS_STORED=100
# DATAFORSEO_MAX_SERP_QUERIES=10
# DATAFORSEO_MAX_SERP_RESULTS=10
# DATAFORSEO_MAX_BACKLINKS_PER_DOMAIN=50
# DATAFORSEO_MAX_REFERRING_DOMAINS=50
# DATAFORSEO_MAX_LINK_GAPS=100
# DATAFORSEO_MAX_CONCURRENT_GLOBAL=2

# ── PRODUCT PROVIDERS: Amazon PA-API 5.0 ─────────────────────────────────────
# From your Amazon Associates / Product Advertising API account.
# Without these, product search runs in clearly-labeled demo mode.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
# e.g. www.amazon.es / www.amazon.com
AMAZON_MARKETPLACE=www.amazon.es

# ── PRODUCT PROVIDERS: eBay Browse API ───────────────────────────────────────
# From https://developer.ebay.com/ (App ID + Cert ID) and your affiliate/ePN
# campaign. Without these, product search runs in clearly-labeled demo mode.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_CAMPAIGN_ID=
# e.g. EBAY-ES / EBAY-US
EBAY_MARKETPLACE=EBAY-ES

# Force demo product data even when provider credentials exist (demo/testing).
PRODUCT_PROVIDERS_FORCE_STUB=false
