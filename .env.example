# =============================================================================
# SEO CRM — ALL ENVIRONMENT VARIABLES (backend + frontend + Railway)
# =============================================================================
# Copy to backend/.env for local dev, or set as shared variables in Railway.
# Railway: Project → Shared Variables (same list for the monorepo service).
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL connection (Railway Postgres plugin injects this automatically)
DATABASE_URL=postgresql+psycopg://seo_crm:seo_crm_dev@localhost:5433/seo_crm

# OpenAI — server-side only, never expose to browser
OPENAI_API_KEY=sk-your-key-here

# Random secret for sessions/tokens (generate: openssl rand -hex 32)
SECRET_KEY=change-me-in-production

# ── SERVER / DEPLOY ──────────────────────────────────────────────────────────

# development | production
APP_ENV=production

# Comma-separated allowed browser origins (add your Railway URL after deploy)
CORS_ORIGINS=https://your-app.up.railway.app,http://localhost:5173

# Set by Railway automatically — do not set manually unless testing locally
# PORT=8000

# Path to built React files (Docker sets this; local prod: ../frontend/dist)
# STATIC_DIR=/app/frontend/dist

# Auto-injected by Railway when you generate a public domain — used for CORS
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# ── GOOGLE OAUTH (Phase 2 — Search Console + Analytics) ──────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match Google Cloud Console redirect URI
# Production: https://your-app.up.railway.app/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# ── GOOGLE SERVICE TARGETS (Phase 2) ─────────────────────────────────────────

# Search Console property, e.g. sc-domain:example.com or https://example.com/
GSC_SITE_URL=

# GA4 numeric property ID
GA4_PROPERTY_ID=

# Google Ads — developer token approval can take weeks
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── BACKGROUND SYNC CRON (Phase 2) ───────────────────────────────────────────

SYNC_GSC_CRON=0 6 * * *
SYNC_GA4_CRON=0 7 * * *
SYNC_ADS_CRON=0 8 * * 1

# ── FRONTEND (only if API is on a different domain) ─────────────────────────
# Not needed for Railway monorepo deploy (API + UI same origin).
# VITE_API_BASE_URL=