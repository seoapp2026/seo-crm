# =============================================================================
# SEO CRM — ALL ENVIRONMENT VARIABLES (backend + Railway shared)
# =============================================================================
# Local dev: copy to backend/.env
# Railway:  Project → Shared Variables (reference Postgres — see below)
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL — see "Railway Postgres" section below
DATABASE_URL=postgresql+psycopg://seo_crm:seo_crm_dev@localhost:5433/seo_crm

# OpenAI — server-side only, never expose to browser
OPENAI_API_KEY=sk-your-key-here

# Random secret for sessions/tokens (generate: openssl rand -hex 32)
SECRET_KEY=change-me-in-production

# ── SERVER / DEPLOY ──────────────────────────────────────────────────────────

# development | production  (production hides /docs)
APP_ENV=production

# Comma-separated allowed browser origins
CORS_ORIGINS=https://seo-crm.up.railway.app,http://localhost:5173

# Hide Swagger in production. Set true only when you need API docs locally.
ENABLE_API_DOCS=false

# Set by Railway automatically — do not set manually
# PORT=8000

# Docker sets this; local prod after npm run build:
# STATIC_DIR=/app/frontend/dist

# Auto-injected by Railway — used for CORS auto-allow
# RAILWAY_PUBLIC_DOMAIN=seo-crm.up.railway.app

# ── RAILWAY POSTGRES (internal link) ─────────────────────────────────────────
#
# Do NOT paste a public URL into .env manually on Railway.
# In your web service → Variables → Add Reference:
#
#   Variable name:  DATABASE_URL
#   Reference:      Postgres → DATABASE_PRIVATE_URL
#                   (or DATABASE_URL — private network preferred)
#
# Railway injects something like:
#   postgresql://postgres:xxx@postgres.railway.internal:5432/railway
#
# The backend auto-converts postgresql:// → postgresql+psycopg:// for SQLAlchemy.
#
# Local dev with docker compose:
#   docker compose up -d
#   DATABASE_URL=postgresql+psycopg://seo_crm:seo_crm_dev@localhost:5433/seo_crm

# ── SPLIT DEPLOY (api.seo-crm subdomain) ─────────────────────────────────────
#
# Two Railway services from the same GitHub repo:
#
#   Service "api-seo-crm"  → Dockerfile.api  → railway.api.toml
#     Domain: api-seo-crm.up.railway.app  (or custom: api.seo-crm.yourdomain.com)
#     Variables: DATABASE_URL (ref Postgres), OPENAI_API_KEY, SECRET_KEY,
#                SERVE_FRONTEND=false, FRONTEND_URL=https://seo-crm.up.railway.app
#
#   Service "seo-crm"      → Dockerfile.web  → railway.web.toml
#     Domain: seo-crm.up.railway.app
#     Variables: VITE_API_BASE=https://api-seo-crm.up.railway.app/api/seo-crm
#
# API health: https://api-seo-crm.up.railway.app/api/seo-crm/health
# API root:   https://api-seo-crm.up.railway.app/  → JSON service info

SERVE_FRONTEND=false
FRONTEND_URL=https://seo-crm.up.railway.app
VITE_API_BASE=https://api-seo-crm.up.railway.app/api/seo-crm

# ── API PATH ─────────────────────────────────────────────────────────────────
# All endpoints live under /api/seo-crm
# Docs only when ENABLE_API_DOCS=true → /api/seo-crm/docs

# ── GOOGLE OAUTH (Phase 2) ────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seo-crm.up.railway.app/api/seo-crm/integrations/google/callback

# ── GOOGLE SERVICE TARGETS (Phase 2) ─────────────────────────────────────────

GSC_SITE_URL=
GA4_PROPERTY_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── BACKGROUND SYNC CRON (Phase 2) ───────────────────────────────────────────

SYNC_GSC_CRON=0 6 * * *
SYNC_GA4_CRON=0 7 * * *
SYNC_ADS_CRON=0 8 * * 1