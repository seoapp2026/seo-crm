# =============================================================================
# SEO CRM — ALL ENVIRONMENT VARIABLES (backend + Railway shared)
# =============================================================================
# Local dev: copy to backend/.env
# Railway:  Project → Shared Variables (reference Postgres — see below)
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL — see "Railway Postgres" section below
DATABASE_URL=postgresql+psycopg://seo_crm:seo_crm_dev@localhost:5433/seo_crm

# OpenAI — server-side only, never expose to browser
OPENAI_API_KEY=sk-your-key-here

# Random secret for sessions/tokens (generate: openssl rand -hex 32)
SECRET_KEY=change-me-in-production

# App login gate — leave empty to disable auth (local dev only)
APP_AUTH_PASSWORD=
# Optional comma-separated allowlist (empty = any email + correct password)
AUTH_ALLOWED_EMAILS=

# ── SERVER / DEPLOY ──────────────────────────────────────────────────────────

# development | production  (production hides /docs)
APP_ENV=production

# Canonical public URL (custom domain)
APP_PUBLIC_URL=https://crmpersonal.es

# Comma-separated allowed browser origins
CORS_ORIGINS=https://crmpersonal.es,https://seo-crm.up.railway.app,http://localhost:5173

# Hide Swagger in production. Set true only when you need API docs locally.
ENABLE_API_DOCS=false

# Set by Railway automatically — do not set manually
# PORT=8000

# Docker sets this; local prod after npm run build:
# STATIC_DIR=/app/frontend/dist

# Auto-injected by Railway — used for CORS auto-allow
# RAILWAY_PUBLIC_DOMAIN=seo-crm.up.railway.app

# ── RAILWAY POSTGRES (internal link) ─────────────────────────────────────────
#
# Do NOT paste a public URL into .env manually on Railway.
# In your web service → Variables → Add Reference:
#
#   Variable name:  DATABASE_URL
#   Reference:      Postgres → DATABASE_PRIVATE_URL
#                   (or DATABASE_URL — private network preferred)
#
# Railway injects something like:
#   postgresql://postgres:xxx@postgres.railway.internal:5432/railway
#
# The backend auto-converts postgresql:// → postgresql+psycopg:// for SQLAlchemy.
#
# Local dev with docker compose:
#   docker compose up -d
#   DATABASE_URL=postgresql+psycopg://seo_crm:seo_crm_dev@localhost:5433/seo_crm

# ── SINGLE SERVICE (monorepo on Railway) ─────────────────────────────────────
# One service uses Dockerfile — frontend + API on the same domain.
# Frontend: https://crmpersonal.es/dashboard
# API:      https://crmpersonal.es/api/seo-crm/health
# Docs:     /api/seo-crm/docs (only when ENABLE_API_DOCS=true)

# ── GOOGLE OAUTH (Phase 2) ────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crmpersonal.es/api/seo-crm/integrations/google/callback

# ── GOOGLE SERVICE TARGETS (Phase 2) ─────────────────────────────────────────

# Opcional — fallback global. Lo normal es configurar por proyecto en Proyectos.
GSC_SITE_URL=
GA4_PROPERTY_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional MCC / Manager account ID (digits only) when accessing client via MCC
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── BACKGROUND SYNC CRON (Phase 2) ───────────────────────────────────────────

SYNC_GSC_CRON=0 6 * * *
SYNC_GA4_CRON=0 7 * * *
SYNC_ADS_CRON=0 8 * * 1

# ── OPTION 2: DataForSEO research (Análisis SEO) ─────────────────────────────
# API login + password from https://app.dataforseo.com/api-access
# (API password ≠ account password). Without these, analyses run in stub mode (0 €).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Force fixture data even if credentials exist
DATAFORSEO_FORCE_STUB=false
# Monthly budget guards (EUR; hard 0 = disabled)
DATAFORSEO_SOFT_MONTHLY_EUR=50
DATAFORSEO_HARD_MONTHLY_EUR=100
# Hard caps per analysis (optional overrides)
DATAFORSEO_MAX_COMPETITORS=3
DATAFORSEO_MAX_SEED_KEYWORDS=20
DATAFORSEO_MAX_KEYWORDS_STORED=100
DATAFORSEO_MAX_SERP_QUERIES=10
DATAFORSEO_MAX_SERP_RESULTS=10
DATAFORSEO_MAX_BACKLINKS_PER_DOMAIN=50
DATAFORSEO_MAX_REFERRING_DOMAINS=50
DATAFORSEO_MAX_LINK_GAPS=100
DATAFORSEO_MAX_CONCURRENT_GLOBAL=2